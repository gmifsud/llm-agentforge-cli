{
  "name": "llm-agentforge-cli",
  "version": "0.2.0",
  "private": true,
  "description": "Bootstrap repos with token-optimised agent instructions and a link to a shared skill vault; manage external skill sources.",
  "license": "MIT",
  "type": "commonjs",
  "bin": { "agentforge": "src/cli/main.js" },
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "agentforge": "node src/cli/main.js",
    "dashboard:start": "node dashboard/server/main.js",
    "dashboard:build": "npm --prefix dashboard/web run build",
    "dashboard:test": "npm --prefix dashboard/web test",
    "dashboard:e2e": "npm --prefix dashboard/web run e2e"
  }
}
